{
  "raw_dir": "data/raw",
  "work_dir": "work",
  "output_dir": "dataset",
  "dataset_name": "vn_license_plate",
  "labels_format": "none",
  "labels_path": "",
  "label_mode": "auto",
  "classes": ["license_plate"],
  "preprocess": {
    "resize_mode": "none",
    "image_size": 640,
    "letterbox_color": [114, 114, 114],
    "scale_up": false,
    "jpeg_quality": 95,
    "keep_unicode_names": false,
    "min_width": 64,
    "min_height": 48,
    "dedupe_exact": true,
    "dedupe_near": false,
    "phash_hamming_threshold": 4,
    "max_compare": 20000,
    "limit": 0
  },
  "autolabel": {
    "enabled": true,
    "class_id": 0,
    "min_area_ratio": 0.0025,
    "max_area_ratio": 0.35,
    "min_aspect_ratio": 1.15,
    "max_aspect_ratio": 6.0,
    "min_fill_ratio": 0.52,
    "min_edge_density": 0.07,
    "score_threshold": 0.45,
    "nms_iou": 0.4,
    "max_boxes_per_image": 4,
    "bilateral_diameter": 9,
    "close_iterations": 2,
    "use_adaptive": true
  },
  "filter": {
    "min_width_px": 12.0,
    "min_height_px": 10.0,
    "min_area_ratio": 0.0001,
    "max_area_ratio": 0.9,
    "min_aspect_ratio": 1.0,
    "max_aspect_ratio": 7.0,
    "keep_empty_images": true
  },
  "split": {
    "val_ratio": 0.15,
    "test_ratio": 0.1,
    "seed": 42,
    "stratify": true,
    "group_aware": true
  },
  "make_preview": true,
  "preview_limit": 24,
  "preview_columns": 4
}
